# Klucz API do TMDB – https://www.themoviedb.org/settings/api
TMDB_API_KEY=your_tmdb_api_key_here

# Port serwera (domyślnie 3000)
PORT=3000

# Supabase – Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here

# Supabase service_role (Settings → API) – TYLKO po stronie serwera.
# Używany przez routes/admin.js do operacji administracyjnych (np. blokada
# logowania w auth.users). NIGDY nie wysyłany do przeglądarki.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Publiczny adres aplikacji — linki w e-mailach (potwierdzenie konta, reset hasła).
# Na Vercel: https://twoja-domena.vercel.app (bez końcowego „/"). Puste = adres,
# pod którym działa strona. Musi być też dodany w Supabase → Auth → URL Configuration.
SITE_URL=

# Sekret Vercel Cron (dowolny długi losowy ciąg) — chroni /api/cron/sweep-sanctions.
# Vercel automatycznie wysyła go w nagłówku Authorization przy wywołaniu crona.
CRON_SECRET=
